  }

  /**
   * å¾…åŠžåˆ—è¡¨åŒºåŸŸã€‚
   */
  @Builder
  buildTodoList() {
    if (this.viewModel.todoItems.length === 0) {
      Column() {
        Text('ðŸ“')
          .fontSize($r('app.float.empty_icon_size'))
          .margin({ bottom: 12 })

        Text('æš‚æ— å¾…åŠžäº‹é¡¹')
          .fontSize($r('app.float.font_size_body'))
          .fontColor('#999999')

        Text('æ·»åŠ ä¸€æ¡æ–°ä»»åŠ¡å¼€å§‹å§')
