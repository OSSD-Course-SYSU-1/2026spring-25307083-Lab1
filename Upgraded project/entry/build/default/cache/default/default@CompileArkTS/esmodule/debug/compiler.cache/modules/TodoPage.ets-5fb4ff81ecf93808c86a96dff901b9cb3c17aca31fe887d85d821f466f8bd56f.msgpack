  /**
   * ç¼–è¾‘å¼¹çª—ã€‚
   */
  @Builder
  buildEditDialog() {
    Column() {
      Column() {
        Text('ç¼–è¾‘å¾…åŠžäº‹é¡¹')
          .fontSize($r('app.float.font_size_title_medium'))
          .fontWeight(FontWeight.Bold)
          .margin({ bottom: 16 })

        TextInput({ text: this.viewModel.editingText })
          .fontSize($r('app.float.font_size_body'))
          .width('100%')
          .height($r('app.float.button_height'))
          .backgroundColor('#F5F5F5')
          .borderRadius(8)
          .padding({ left: 12, right: 12 })
          .onChange((value: string) => {
            this.viewModel.editingText = value;
          })
          .onSubmit(() => {
            this.viewModel.confirmEdit();
            this.showEditDialog = false;
          })

        Row() {
          Button('å–æ¶ˆ')
            .fontSize($r('app.float.font_size_caption'))
            .fontColor('#666666')
            .backgroundColor('#F5F5F5')
            .layoutWeight(1)
            .height($r('app.float.button_dialog_height'))
            .borderRadius(8)
            .margin({ right: 8 })
            .onClick(() => {
              this.viewModel.cancelEdit();
              this.showEditDialog = false;
            })

          Button('ç¡®è®¤')
            .fontSize($r('app.float.font_size_caption'))
            .fontColor(Color.White)
            .backgroundColor('#007DFF')
            .layoutWeight(1)
            .height($r('app.float.button_dialog_height'))
            .borderRadius(8)
            .onClick(() => {
              this.viewModel.confirmEdit();
              this.showEditDialog = false;
            })
        }
        .width('100%')
        .margin({ top: 16 })
      }
      .width('80%')
      .padding(20)
      .backgroundColor(Color.White)
      .borderRadius(16)
      .shadow({ radius: 20, color: '#30000000' })
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Center)
    .backgroundColor('#50000000')
    .position({ x: 0, y: 0 })
    .onClick(() => {
      // ç‚¹å‡»é®ç½©å…³é—­
      this.viewModel.cancelEdit();
      this.showEditDialog = false;
    })
    .hitTestBehavior(HitTestMode.Block)
  }

  /**
   * æ ¼å¼åŒ–æ—¶é—´æˆ³ä¸ºå¯è¯»å­—ç¬¦ä¸²ã€‚
   */
  private formatTime(timestamp: number): string {
    const date = new Date(timestamp);
    const now = new Date();
    const diff = now.getTime() - timestamp;
    const oneDay = 24 * 60 * 60 * 1000;

    const hours = date.getHours().toString().padStart(2, '0');
    const minutes = date.getMinutes().toString().padStart(2, '0');

    if (diff < oneDay && now.getDate() === date.getDate()) {
      return `ä»Šå¤© ${hours}:${minutes}`;
    }
    const month = (date.getMonth() + 1).toString().padStart(2, '0');
    const day = date.getDate().toString().padStart(2, '0');
    return `${month}-${day} ${hours}:${minutes}`;
  }
}
