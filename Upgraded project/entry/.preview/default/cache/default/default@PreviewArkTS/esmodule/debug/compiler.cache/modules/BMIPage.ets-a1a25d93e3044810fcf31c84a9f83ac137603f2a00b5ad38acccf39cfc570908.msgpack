        if (this.bmiValue < 24.9)
            return 'æ‚¨çš„ä½“é‡åœ¨æ­£å¸¸èŒƒå›´å†…ï¼Œè¯·ç»§ç»­ä¿æŒå¥åº·çš„ç”Ÿæ´»æ–¹å¼ã€‚';
        if (this.bmiValue < 29.9)
            return 'æ‚¨çš„ä½“é‡åé‡ï¼Œå»ºè®®æŽ§åˆ¶é¥®é£Ÿå¹¶é€‚å½“å¢žåŠ è¿åŠ¨é‡ã€‚';
        if (this.bmiValue < 34.9)
            return 'æ‚¨çš„ä½“é‡å±žäºŽè‚¥èƒ–èŒƒå›´ï¼Œå»ºè®®å’¨è¯¢åŒ»ç”Ÿåˆ¶å®šç§‘å­¦å‡é‡è®¡åˆ’ã€‚';
        return 'æ‚¨çš„ä½“é‡å±žäºŽé‡åº¦è‚¥èƒ–ï¼Œå»ºè®®å°½å¿«å°±åŒ»è¿›è¡Œä¸“ä¸šå‡é‡æŒ‡å¯¼ã€‚';
    }
    getScaleWidth(level) {
        let total = 40; // 0-40 BMI scale
        let w = ((level.max - level.min) / total * 100).toFixed(1);
