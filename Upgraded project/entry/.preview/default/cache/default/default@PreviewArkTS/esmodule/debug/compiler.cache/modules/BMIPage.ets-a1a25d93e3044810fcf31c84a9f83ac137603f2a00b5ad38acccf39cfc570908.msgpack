import router from '@ohos.router';

enum UnitSystem {
  METRIC = 'å…¬åˆ¶',
  IMPERIAL = 'è‹±åˆ¶'
}

class BMILevel {
  label: string;
  min: number;
  max: number;
  color: string;

  constructor(label: string, min: number, max: number, color: string) {
    this.label = label;
    this.min = min;
    this.max = max;
    this.color = color;
  }
}

@Entry
@Component
struct BMIPage {
  @State unitSystem: UnitSystem = UnitSystem.METRIC;

  // å…¬åˆ¶
  @State heightCm: string = '170';
  @State weightKg: string = '65';

  // è‹±åˆ¶
  @State heightFt: string = '5';
  @State heightIn: string = '7';
  @State weightLb: string = '143';

  // ç»“æžœ
  @State bmiValue: number = 0;
  @State bmiCategory: string = '';
  @State bmiColor: string = '#4CAF50';
  @State idealWeight: string = '';
  @State showResult: boolean = false;

  private levels: BMILevel[] = [
    new BMILevel('åç˜¦', 0, 18.5, '#2196F3'),
    new BMILevel('æ­£å¸¸', 18.5, 24.9, '#4CAF50'),
    new BMILevel('åé‡', 25, 29.9, '#FF9800'),
    new BMILevel('è‚¥èƒ–', 30, 34.9, '#FF5722'),
    new BMILevel('é‡åº¦è‚¥èƒ–', 35, 100, '#F44336'),
  ];

  aboutToAppear(): void {
    this.calculate();
  }

  build() {
    Column() {
      this.buildHeader();

      Scroll() {
        Column() {
          // å•ä½åˆ¶åˆ‡æ¢
          this.buildUnitToggle();

          if (this.unitSystem === UnitSystem.METRIC) {
            this.buildMetricInputs();
          } else {
            this.buildImperialInputs();
          }

          // è®¡ç®—æŒ‰é’®
          Button('è®¡ç®— BMI')
            .fontSize($r('app.float.font_size_body'))
            .fontColor(Color.White)
            .backgroundColor('#007DFF')
            .width('100%')
            .height(48)
            .borderRadius(12)
            .margin({ top: 12, left: 16, right: 16 })
            .onClick(() => { this.calculate(); })

          // ç»“æžœå±•ç¤º
          if (this.showResult) {
            this.buildResultPanel();
          }
        }
        .width('100%')
      }
      .layoutWeight(1)
      .width('100%')
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F1F3F5')
  }

  @Builder
  buildHeader() {
    Row() {
      Button({ type: ButtonType.Circle }) {
        Text('â†').fontSize($r('app.float.font_size_title_large')).fontColor('#333333')
