  }

  @Builder
  buildInputs() {
    Column() {
      if (this.useTotalPrice) {
        this.buildInputRow('æˆ¿å±‹æ€»ä»·', this.totalPrice, 'ä¸‡å…ƒ',
          (v) => { this.totalPrice = v; });
        this.buildInputRow('é¦–ä»˜æ¯”ä¾‹', this.downPayment, '%',
          (v) => { this.downPayment = v; });
      } else {
        this.buildInputRow('è´·æ¬¾é‡‘é¢', this.loanAmount, 'ä¸‡å…ƒ',
          (v) => { this.loanAmount = v; });
      }

      this.buildInputRow('å¹´åˆ©çŽ‡', this.annualRate, '%',
        (v) => { this.annualRate = v; });

